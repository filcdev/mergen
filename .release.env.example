# GitHub release destination
GITHUB_REPO=filcdev/mergen
RELEASE_TAG=dev-latest
RELEASE_TITLE=Mergen – latest developer build

# 1 = publish to GitHub Releases, 0 = build locally only
PUBLISH=1

# auto = iOS on macOS, skip iOS elsewhere
# 0    = Android only
BUILD_IOS=auto

# Optional: required only for a signed device IPA.
# Do NOT put private keys or certificate passwords here.
APPLE_TEAM_ID=

# Optional. If empty, release.sh uses:
# hu.petrik.filcapp.Filcapp${APPLE_TEAM_ID}
IOS_BUNDLE_ID=

# Usually "development" for developer devices.
# "ad-hoc" can be used when the team has an Ad Hoc distribution profile.
IOS_EXPORT_METHOD=development

# CFBundleShortVersionString for the iOS developer build.
IOS_MARKETING_VERSION=1.0.0
