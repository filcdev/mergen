# Mergen (Kotlin Multiplatform) iOS release lane.
#
# Triggered by .github/workflows/release.yml on a published GitHub Release.
# Builds with gym and uploads to App Store Connect / TestFlight using the App
# Store Connect API key and Xcode automatic signing.

# Do not send usage/analytics data to Fastlane.
opt_out_usage

# Safe, non-interactive defaults under CI (never auto-update mid-build).
ENV["FASTLANE_SKIP_UPDATE_CHECK"] ||= "true"

platform :ios do
  # KMP note:
  #   * There is no `.xcworkspace`, so `gym` uses `project:` (not `workspace:`).
  #   * The Kotlin framework is compiled and embedded by the Xcode "Compile
  #     Kotlin Framework" Run Script phase (which calls
  #     `./gradlew :composeApp:embedAndSignAppleFrameworkForXcode`), so there is
  #     no separate Gradle step here.
  #   * Versions are injected via build settings (MARKETING_VERSION /
  #     CURRENT_PROJECT_VERSION) rather than mutating the project with
  #     increment_version_number / increment_build_number, keeping the checkout
  #     clean on CI.
  lane :release do
    version      = ENV["VERSION"]
    asc_key_id   = ENV["ASC_KEY_ID"]
    asc_issuer   = ENV["ASC_ISSUER_ID"]
    asc_key_path = ENV["ASC_KEY_PATH"]

    UI.user_error!("version is required") if version.to_s.strip.empty?
    UI.user_error!("asc_key_id is required") if asc_key_id.to_s.strip.empty?
    UI.user_error!("asc_issuer is required") if asc_issuer.to_s.strip.empty?
    UI.user_error!("asc_key_path is required") if asc_key_path.to_s.strip.empty?
    UI.user_error!("TEAM_ID is required") if ENV["TEAM_ID"].to_s.strip.empty?

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer,
      key_filepath: asc_key_path,
      in_house: false,
    )

    # Derive the next TestFlight build number; fall back to 1 on the very first
    # release, when the app has no TestFlight builds yet.
    begin
      build_number = (latest_testflight_build_number(api_key: api_key).to_i + 1).to_s
    rescue StandardError => e
      UI.important("No existing TestFlight build found (#{e.message}); using build number 1.")
      build_number = "1"
    end

    gym(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "mergen.ipa",
      clean: true,
      # Automatic signing via the App Store Connect API key; -allowProvisioningUpdates
      # lets Xcode create/refresh the distribution profile automatically.
      # DEVELOPMENT_TEAM comes from the TEAM_ID env var on CI.
      xcargs: "-allowProvisioningUpdates DEVELOPMENT_TEAM=#{ENV['TEAM_ID']} MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: "-allowProvisioningUpdates",
    )

    # `submit_for_review: true` would auto-submit for review; the build normally
    # lands in TestFlight first, with submission happening in App Store Connect.
    upload_to_app_store(
      api_key: api_key,
      ipa: "build/ios/mergen.ipa",
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
    )
  end
end
