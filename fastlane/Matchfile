# git_url is read from MATCH_REPO_URL (set by the CI env) — no hardcoded repo here.
git_url(ENV["MATCH_REPO_URL"])
storage_mode("git")
type("appstore")
app_identifier("hu.petrik.filcapp.Filcapp")

