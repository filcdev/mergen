# Android emulator / local development. Copy to .env (ignored by Git).
# Physical device: use your PC's LAN address instead of 10.0.2.2.
# Entra IDs are public identifiers; NEVER put a client secret in a mobile project.
MERGEN_API_ORIGIN=http://10.0.2.2:3001
MERGEN_ENTRA_CLIENT_ID=
MERGEN_ENTRA_TENANT_ID=

# Public Firebase Android app settings (never a Firebase service-account JSON).
MERGEN_FCM_APP_ID=
MERGEN_FCM_SENDER_ID=
MERGEN_FCM_API_KEY=
MERGEN_FCM_PROJECT_ID=
